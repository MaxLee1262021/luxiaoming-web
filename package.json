{
  "name": "luxiaoming-admin",
  "version": "1.0.0",
  "private": true,
  "description": "鹿小鸣长沙旅拍 Web 管理后台",
  "scripts": {
    "dev": "node scripts/serve.cjs",
    "start": "node scripts/serve.cjs",
    "server": "node server/index.cjs",
    "backup:mysql": "node scripts/backup-mysql.cjs",
    "migrate:mysql": "node scripts/migrate-mysql.cjs",
    "migrate:passwords": "node scripts/migrate-passwords.cjs",
    "oss:check": "node scripts/oss-check.cjs",
    "migrate:files": "node scripts/migrate-files.cjs",
    "package:linux": "node scripts/package-linux.cjs",
    "test": "node --test server/tests/*.test.cjs src/tests/*.test.cjs",
    "check": "node scripts/check-syntax.cjs",
    "lint": "echo \"静态演示版暂未接入 ESLint 运行时依赖，已提供 eslint.config.js 规范文件\"",
    "build": "node scripts/serve.cjs --check-only"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^3.18.3",
    "ali-oss": "^6.23.0",
    "dotenv": "^17.4.2",
    "mysql2": "^3.24.3"
  },
  "optionalDependencies": {
    "redis": "^6.2.1"
  }
}
