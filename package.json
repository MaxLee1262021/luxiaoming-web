    "migrate:photo-share": "node scripts/migrate-photo-share.cjs",
    "cleanup:photo-share": "node scripts/cleanup-photo-share.cjs",
    "migrate:customer-service": "node scripts/migrate-customer-service.cjs",
    "migrate:wecom-contacts": "node scripts/migrate-wecom-contacts.cjs",
