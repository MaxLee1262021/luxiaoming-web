[Unit]
Description=Luxiaoming Admin Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luxiaoming
Group=luxiaoming
WorkingDirectory=/opt/luxiaoming-admin
ExecStart=/opt/luxiaoming-admin/deploy/linux/start.sh
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
