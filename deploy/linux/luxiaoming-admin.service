[Unit]
Description=Luxiaoming Admin Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luxiaoming
Group=luxiaoming
WorkingDirectory=/opt/luxiaoming-admin
ExecStart=/opt/luxiaoming-admin/deploy/linux/start.sh
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
