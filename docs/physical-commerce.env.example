# Copy selected values into the server's private environment, never a client bundle.
# Start disabled; migrate and complete staging checks before enabling sales.
PHYSICAL_WORKER_ENABLED=true
PHYSICAL_WORKER_INTERVAL_MS=30000

# kuaidi100 ordinary query + subscription account. Purchase the matching API plan.
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=
KUAIDI100_CALLBACK_URL=https://your-api.example/api/physical/logistics/kuaidi100/notify
KUAIDI100_TIMEOUT_MS=8000

# WeChat shipping management is separate from payment and kuaidi100 tracking.
# Enable only if this mini-program is authorized for the corresponding APIs.
WECHAT_SHIPPING_ENABLED=false
WX_APP_ID=
WX_APP_SECRET=
WECHAT_SHIPPING_TIMEOUT_MS=8000
# Obtain IDs from the WeChat carrier list for the actual account. These are not
# kuaidi100 codes. Example format only; verify each mapping before use.
WECHAT_SHIPPING_CARRIER_MAP={"shunfeng":"SF"}
