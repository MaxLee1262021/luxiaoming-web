# Merge these values into deployment configuration, outside the repository.
# Keep enable time empty until the actual launch date is confirmed.
SHARE_ENABLE_AT=
DEFAULT_TTL_HOURS=720
MAX_CANDIDATE_MERCHANTS=20
SCAN_DEDUP_SECONDS=5
CS_ATTR_DAYS=7
JUDGE_RETRY_MAX=3

# HTTPS adapters provided by operations. Critical delivery must trigger a phone call.
SHARE_ALERT_WEBHOOK_URL=
SHARE_PHONE_ALERT_URL=

# Optional. When empty, derive refund-notify from the payment notification host.
WECHAT_PAY_REFUND_NOTIFY_URL=
