# 鹿小鸣管理后台 · 配置模板
# 用法：把本文件复制为 .env 并填入真实值（.env 已被 gitignore，不会进仓库）。

# ============ 运行环境 / 数据层模式 DATA_MODE ============
# 本地开发用 development；正式部署必须显式改为 production。
NODE_ENV=development
# json  （默认，开发/测试）数据存服务器本地文件 server/data/db.json，零依赖零安装
# mysql （生产，宝塔装好 MySQL 后）配合下面 DB_* 使用
# mock  （旧演示）内存数据，重启还原
# cloud （兼容旧）腾讯云开发，配合下面 CLOUDBASE_* 使用
DATA_MODE=json

# ============ 后台会话存储 ============
# memory 仅适合单进程本地开发；生产建议 redis，并填写 URL 或 REDIS_HOST 等字段。
SESSION_STORE=memory
SESSION_TTL_SECONDS=28800
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=1500

# 开发环境可显式开启固定匿名小程序身份；生产/staging 强制关闭并必须配置微信凭据。
ALLOW_DEV_OPENID=false
SEED_DEMO_DATA=false

# 跨域白名单，逗号分隔；同源部署可留空。
ADMIN_CORS_ORIGINS=

# ============ 生产 MySQL（宝塔装的 MySQL） ============
# 在宝塔「数据库」里新建一个，把连接信息填这里；DATA_MODE=mysql 时生效
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=luxiaoming
DB_PASSWORD=你的MySQL密码
DB_NAME=luxiaoming
DB_SSL=false
# 首次初始化可临时设为 true 创建 lxm_* 表，完成后改回 false 并走正式迁移。
DB_AUTO_MIGRATE=false

# ============ 兼容旧：腾讯云开发（一般不用了） ============
CLOUDBASE_ENV_ID=luxiaoming-d6g3h8od03453f80f
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=

# ============ 微信支付（锁定预约¥10，正式商用前再填） ============
# 不填则开发期走"客服线下收"通道，不影响开发测试
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_MCH_KEY=
WECHAT_CERT_PATH=

# ============ 后台登录密码（生产务必设置） ============
ADMIN_PASSWORD=
