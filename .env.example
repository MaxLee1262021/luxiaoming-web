# 鹿小鸣管理后台 · 配置模板
# 用法：把本文件复制为 .env 并填入真实值（.env 已被 gitignore，不会进仓库）。

# ============ 运行环境 / 数据层 ============
# 本地开发用 development；服务运行时所有 API 请求均使用 MySQL。
NODE_ENV=development
# DATA_MODE 在运行时固定为 mysql；JSON 仅供 Node 隔离测试使用。
DATA_MODE=mysql

# ============ 后台会话存储 ============
# 本机单进程开发可使用 memory；生产/多实例请改为 redis 并填写下方连接信息。
SESSION_STORE=memory
SESSION_TTL_SECONDS=28800
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=1500

# 开发环境可显式开启固定匿名小程序身份；生产/staging 强制关闭并必须配置微信凭据。
ALLOW_DEV_OPENID=false
# ============ 微信小程序登录 / 手机号授权 ============
# 正式部署请在部署平台的密钥管理中配置以下值，绝不提交真实 AppSecret 或写入前端。
# WX_APP_ID 为微信小程序 AppID；WX_APP_SECRET 为同一小程序的 AppSecret。
# 服务端使用 code 换取 openid，并使用手机号授权 code 向微信服务端验码；生产/staging 会禁用开发身份兜底。
WX_APP_ID=
WX_APP_SECRET=

# 跨域白名单，逗号分隔；同源部署可留空。
ADMIN_CORS_ORIGINS=

# ============ 阿里云 OSS（服务端配置，单私有桶） ============
# OSS_REGION 使用 Bucket 所在地域；以下上海值仅为示例。
# 填写后先执行 npm run oss:check，只读检查通过不代表具备对象上传权限。
OSS_BUCKET=luxiaoming
OSS_REGION=cn-shanghai
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_KEY_PREFIX=luxiaoming/prod/
# RAM 身份仅授权指定 Bucket / Prefix，参考 docs/oss-ram-policy.json。
# AccessKey 与可选 STS token 仅在服务端使用，禁止写入前端或提交到仓库。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=
# 可选：已绑定 Bucket、配置有效 TLS 的自定义 HTTPS 读取域名（不带路径）。
# 留空使用 OSS 默认域名；上传仍使用对应 Bucket 的标准公网 HTTPS 域名。
OSS_READ_DOMAIN=

# ============ 高德地图 Web JS API（后台打卡点选坐标） ============
# 在高德控制台创建“Web端(JS API)”Key，并将后台正式访问域名加入域名白名单。
# Key 会通过运行时脚本提供给浏览器；它不是安全密钥，仍不应硬编码到源码。
AMAP_WEB_JS_KEY=
# 只由服务端同源 /_AMapService 代理使用，绝不可写进前端、静态文件或提交到仓库。
# 留空时可配置下方已有安全密钥的 HTTPS 反向代理地址；二者至少配置一种。
AMAP_SECURITY_JS_CODE=
# 可选：外部反向代理地址，必须以 /_AMapService 结尾，例如 https://admin.example.com/_AMapService。
# 留空且已配置 AMAP_SECURITY_JS_CODE 时，本 Node 服务提供同源代理；生产环境外部地址必须为 HTTPS。
AMAP_SERVICE_HOST=
# 可选：同源代理请求超时，单位毫秒，默认 8000，范围 1000-30000。
AMAP_PROXY_TIMEOUT_MS=8000

# ============ 本地 MySQL ============
# 先执行 npm run migrate:mysql -- --apply；真实密码只写入本机 .env，绝不提交。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=luxiaoming_admin
DB_SSL=false
# One process creates separate business and authorization pools. Set this from
# the database connection budget; the default is intentionally conservative.
DB_CONNECTION_LIMIT=10
# Slow database statements are emitted as structured logs without SQL values.
DB_SLOW_QUERY_MS=500
DB_SLOW_TRANSACTION_MS=1000
# Relation hydration uses IN batches; this bounds SQL parameter and memory use.
DB_RELATION_BATCH_SIZE=500
# HTTP completion logs include requestId, module, duration and DB query totals.
LOG_LEVEL=info
HTTP_ACCESS_LOG_ENABLED=true
HTTP_SLOW_REQUEST_MS=1000
# 首次初始化可临时设为 true 创建/修复规范化 lxm_* 表；确认完成后必须改回 false。
# 检测到旧 doc 表时运行时会 fail-closed，请先执行正式迁移命令。
DB_AUTO_MIGRATE=false

# ============ 兼容旧：腾讯云开发（一般不用了） ============
CLOUDBASE_ENV_ID=luxiaoming-d6g3h8od03453f80f
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=

# ============ 微信支付 API v3（小程序 JSAPI） ============
# 仅配置在服务器密钥管理/本机 .env，绝不提交私钥或 APIv3 密钥。
# WECHAT_PAY_APP_ID 必须与上方 WX_APP_ID 是同一个小程序 AppID；两者可只填 WX_APP_ID。
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_SERIAL_NO=
# 商户 API 证书私钥 apiclient_key.pem 的绝对路径；也可用 WECHAT_PAY_MCH_PRIVATE_KEY 直接注入 PEM。
WECHAT_PAY_MCH_PRIVATE_KEY_PATH=
WECHAT_PAY_MCH_PRIVATE_KEY=
# 商户平台设置的 32 字节 APIv3 密钥，用于解密支付回调。
WECHAT_PAY_API_V3_KEY=
# 必须是外网可访问的 HTTPS 回调地址，不能带查询字符串。
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/payments/wechat/notify
# 二选一配置验签材料。优先使用微信支付公钥；也支持平台证书。
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=
WECHAT_PAY_PLATFORM_CERT_PATH=
# 证书/公钥轮换时保留旧、新两套验签材料。JSON 数组元素支持
# {"serialNo":"...","publicKeyPath":"/secure/wxp_pub.pem"} 或 {"serialNo":"...","certificatePath":"/secure/platform.pem"}。
WECHAT_PAY_PLATFORM_VERIFIERS=[]
# 可选，默认 api.mch.weixin.qq.com；仅联调环境按微信支付要求覆盖。
WECHAT_PAY_API_HOST=
WECHAT_PAY_TIMEOUT_MS=10000
# 预支付单恢复策略：prepay_id 在有效期前主动关单后重新创建，避免用户卡在待支付。
WECHAT_PAY_PREPAY_TTL_MS=6600000
WECHAT_PAY_PREPAY_RECOVERY_GRACE_MS=60000
# 临时审核期模拟支付：设为 mock 时，客户点击常规支付按钮会由服务端写入
# provider=mock_payment 的已确认流水，不会请求微信支付。审核通过后改为 wechat
# （或留空）并重启服务，新的支付立即恢复为真实微信支付；历史模拟流水会保留审计标记。
# PAYMENT_MODE=test 仍只启用隔离测试环境的 testPayment RPC，不能在生产使用。
PAYMENT_MODE=wechat
# 仅本地/隔离验收环境使用；生产必须保持 false，不能伪装微信支付。
TEST_PAYMENT_ENABLED=false

# ============ 后台登录密码（生产务必设置） ============
ADMIN_PASSWORD=
