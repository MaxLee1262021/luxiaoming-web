# 鹿小鸣管理后台 · 配置模板
# 用法：把本文件复制为 .env 并填入真实值（.env 已被 gitignore，不会进仓库）。

# ============ 运行环境 / 数据层模式 DATA_MODE ============
# 本地开发用 development；正式部署必须显式改为 production。
NODE_ENV=development
# json  （仅离线开发/测试）数据存服务器本地文件 server/data/db.json
# mysql （本项目本地运行默认）配合下面 DB_* 使用，先执行 npm run migrate:mysql -- --apply
# mock  （旧演示）内存数据，重启还原
# cloud （兼容旧）腾讯云开发，配合下面 CLOUDBASE_* 使用
DATA_MODE=mysql

# ============ 后台会话存储 ============
# 本机单进程开发可使用 memory；生产/多实例请改为 redis 并填写下方连接信息。
SESSION_STORE=memory
SESSION_TTL_SECONDS=28800
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT_MS=1500

# 开发环境可显式开启固定匿名小程序身份；生产/staging 强制关闭并必须配置微信凭据。
ALLOW_DEV_OPENID=false
SEED_DEMO_DATA=false

# 跨域白名单，逗号分隔；同源部署可留空。
ADMIN_CORS_ORIGINS=

# ============ 本地 MySQL ============
# 先执行 npm run migrate:mysql -- --apply；真实密码只写入本机 .env，绝不提交。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=luxiaoming_admin
DB_SSL=false
# 首次初始化可临时设为 true 创建/修复规范化 lxm_* 表；确认完成后必须改回 false。
# 检测到旧 doc 表时运行时会 fail-closed，请先执行正式迁移命令。
DB_AUTO_MIGRATE=false

# ============ 兼容旧：腾讯云开发（一般不用了） ============
CLOUDBASE_ENV_ID=luxiaoming-d6g3h8od03453f80f
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=

# ============ 微信支付（锁定预约¥10，正式商用前再填） ============
# 不填则开发期走"客服线下收"通道，不影响开发测试
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_MCH_KEY=
WECHAT_CERT_PATH=

# ============ 后台登录密码（生产务必设置） ============
ADMIN_PASSWORD=
